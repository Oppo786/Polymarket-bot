# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Trading Execution Mode: DRY_RUN (default, safe simulation) or LIVE (real order submission)
TRADING_MODE="DRY_RUN"

# Polymarket Account Credentials (stored server-side only; never exposed to frontend)
# Wallet Private key for EIP-712 order signing (0x...)
POLYMARKET_PRIVATE_KEY=""

# Polymarket CLOB API Credentials (L2 HMAC authentication)
POLYMARKET_API_KEY=""
POLYMARKET_API_SECRET=""
POLYMARKET_API_PASSPHRASE=""

# Funder/Proxy address (Required if using Magic Link, Email, or Proxy deposit contract)
POLYMARKET_FUNDER_ADDRESS=""

# Signature Type: 0 = EOA (Standard Private Key), 1 = PolyProxy (Magic / Email wallet), 2 = Gnosis Safe
POLYMARKET_SIGNATURE_TYPE="0"

# Network Chain ID (137 for Polygon Mainnet)
POLYMARKET_CHAIN_ID="137"

# Polymarket Host endpoints
POLYMARKET_CLOB_HOST="https://clob.polymarket.com"
POLYMARKET_GAMMA_HOST="https://gamma-api.polymarket.com"
POLYMARKET_WS_HOST="wss://ws-subscriptions-clob.polymarket.com/ws/market"

# Optional security password to protect dashboard settings and conditional order submission
DASHBOARD_AUTH_PASSWORD=""

# Database path (SQLite file stored in persistent volume)
DATABASE_PATH="./data/trader.sqlite"
